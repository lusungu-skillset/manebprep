# Production Environment Variables
# Deploy to Render: Copy these values into Render's Environment tab

# Node Environment
NODE_ENV=production
LOG_LEVEL=warn

# Port (Render assigns this automatically, but can be overridden)
PORT=5000

# Database - Use your Supabase PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres.umaxgqmatgpgcmmmpwsm:LusunguMhango@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Admin API Key
ADMIN_API_KEY=maneb-admin-secure-key

# Frontend URL (for CORS)
# Update this to your deployed frontend URL
FRONTEND_URL=https://yourfrontend.vercel.app

# Optional: Additional frontend URLs (comma-separated)
# FRONTEND_URL=https://yourfrontend.vercel.app,https://www.yourfrontend.vercel.app
